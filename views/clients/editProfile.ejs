<div class="profile-container">
  <% if (typeof title !== 'undefined' && title) { %>
    <h1 class="page-title"><%= title %></h1>
  <% } else { %>
    <h1 class="page-title">Edit Profile</h1>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="error-message">
      <p><%= error %></p>
    </div>
  <% } %>

  <section class="client-profile-card">
    <form action="/clients/profile/edit" method="POST" enctype="multipart/form-data" class="edit-form">
      
      <div class="form-avatar-section">
        <div class="profile-avatar edit-mode">
          <% if (sessionUser.clientAvatar) { %>
            <img src="<%= sessionUser.clientAvatar %>" alt="Current Avatar">
          <% } else { %>
            <span><%= sessionUser.clientName ? sessionUser.clientName.charAt(0).toUpperCase() : 'C' %></span>
          <% } %>
        </div>
        <div class="avatar-upload-controls">
          <label for="clientAvatar" class="file-upload-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            Choose New Photo
          </label>
          <input type="file" id="clientAvatar" name="clientAvatar" accept="image/*" class="file-input-hidden">
          <p class="file-help-text">JPG, PNG or GIF. Max 2MB.</p>
        </div>
      </div>

      <hr class="divider">

      <div class="card-body">
        <div class="form-group">
          <label for="clientName">Full Name</label>
          <input type="text" id="clientName" name="clientName" value="<%= sessionUser.clientName %>" required placeholder="John Doe">
        </div>
        
        <div class="form-group">
          <label for="clientEmail">Email Address</label>
          <input type="email" id="clientEmail" name="clientEmail" value="<%= sessionUser.clientEmail %>" required placeholder="name@example.com">
        </div>
        
        <div class="form-group">
          <label for="clientPhone">Phone Number</label>
          <input type="text" id="clientPhone" name="clientPhone" value="<%= sessionUser.clientPhone %>" required placeholder="e.g., +1234567890">
        </div>
        
        <div class="form-group full-width">
          <label for="clientAddress">Physical Address</label>
          <input type="text" id="clientAddress" name="clientAddress" value="<%= sessionUser.clientAddress %>" required placeholder="Street address, Suite, City, State">
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a href="/clients/profile" class="btn-light">Cancel</a>
      </div>
    </form>
  </section>
</div>