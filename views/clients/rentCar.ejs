<% if (typeof title !== 'undefined' && title) { %>
  <h1><%= title %></h1>
<% } else { %>
  <h1>Rent a Car</h1>
<% } %>

<section class="rent-page">
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="rent-error"><%= error %></p>
  <% } %>

  <div class="reservation-container">
    <div class="reservation-header">
      <h2>Rent Information</h2>

      <p class="rent-vehicle-name">
        <strong>Vehicle:</strong>
        <%= car.brand || car.make %> <%= car.model %> (<%= car.year %>)
      </p>

      <p class="daily-rate">
        Daily Rate:
        <strong>
          <span id="base-price" data-price="<%= Number(car.dailyPrice) %>">
            $<%= parseFloat(car.dailyPrice).toFixed(2) %>
          </span>
          per day
        </strong>
      </p>
    </div>

    <form action="/clients/rent/<%= car.vehicleId %>" method="POST" id="rental-form" class="rental-form">
      <div class="form-group">
        <label for="startDate">Start Date</label>
        <input type="date" id="startDate" name="startDate" required>
      </div>

      <div class="form-group">
        <label for="endDate">End Date</label>
        <input type="date" id="endDate" name="endDate" required>
      </div>

      <div class="price-summary">
        <p>
          Total Duration:
          <strong><span id="total-days">0</span> days</strong>
        </p>

        <h3>
          Estimated Price:
          <span>$<span id="display-total">0.00</span></span>
        </h3>
      </div>

      <button type="submit" class="btn-primary rent-submit-btn">
        Request Rental
      </button>
    </form>
  </div>
</section>

<script src="/utilities/bookingCalculator.js"></script>