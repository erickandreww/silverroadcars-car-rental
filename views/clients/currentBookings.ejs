<div class="dashboard-container">
  <header class="dashboard-header">
    <div class="welcome-meta">
      <h1>Welcome, <%= sessionUser.clientName ? sessionUser.clientName : 'User' %>!</h1>
      <p>Manage your rental assets, schedules, and billing status below.</p>
    </div>
    
    <nav class="dashboard-nav">
      <a href="/vehicles/browse" class="nav-link">Browse Vehicles</a>
      <a href="/clients/profile" class="nav-link">My Profile</a>
      <a href="/clients/bookings" class="nav-link active">Booking History</a>
    </nav>
  </header>

  <main class="dashboard-content">
    <div class="content-title-area">
      <h2><%= typeof title !== 'undefined' && title ? title : 'Current Bookings' %></h2>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-banner">
        <p><%= error %></p>
      </div>
    <% } %>

    <section class="bookings-wrapper">
      <% if (locals.bookings && bookings.length > 0) { %>
        <div class="table-responsive">
          <table class="modern-data-table">
            <thead>
              <tr>
                <th>Vehicle Info</th>
                <th>Plate Number</th>
                <th>Rental Period</th>
                <th>Total Value</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% bookings.forEach(booking => { %>
                <tr>
                  <td>
                    <div class="vehicle-info-cell">
                      <span class="vehicle-title"><%= booking.brand %> <%= booking.model %></span>
                    </div>
                  </td>
                  
                  <td>
                    <span class="plate-badge"><%= booking.plate %></span>
                  </td>
                  
                  <td>
                    <div class="date-cell">
                      <span><%= new Date(booking.startDate).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %></span>
                      <span class="date-arrow">→</span>
                      <span><%= new Date(booking.endDate).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %></span>
                    </div>
                  </td>
                  
                  <td>
                    <span class="amount-value">$<%= parseFloat(booking.totalValue).toFixed(2) %></span>
                  </td>
                  
                  <td>
                    <span class="status-pill <%= booking.bookingStatus.toLowerCase() %>">
                      <%= booking.bookingStatus %>
                    </span>
                  </td>  
                  
                  <td class="text-right">
                    <% if (booking.bookingStatus.toLowerCase() === 'approved') { %>
                      <a href="/clients/payment/<%= booking.bookingId %>" class="btn-action-pay">
                        Pay Now
                      </a>
                    <% } else { %>
                      <span class="status-text-settled">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Settled
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <p>You don't have any active bookings scheduled at the moment.</p>
          <a href="/vehicles/browse" class="btn-action-pay" style="display:inline-block; margin-top:0.5rem;">Explore Vehicles</a>
        </div>
      <% } %>
    </section>
  </main>
</div>