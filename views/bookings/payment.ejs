<% if (title) { %>
  <h1><%= title %></h1>
<% } %>

<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<section class="payment-page">
  <% if (data) { %>
    <div class="payment-card">
      <div class="payment-header">
        <h2>Complete Payment</h2>
        <p>Review your booking information and confirm your payment.</p>
      </div>

      <div class="payment-content">
        <div class="payment-summary">
          <h3>Booking Summary</h3>

          <div class="summary-row">
            <span>Vehicle</span>
            <strong><%= data.brand %> <%= data.model %></strong>
          </div>

          <div class="summary-row">
            <span>Plate</span>
            <strong><%= data.plate || "N/A" %></strong>
          </div>

          <div class="summary-row">
            <span>Start Date</span>
            <strong><%= data.startDate ? new Date(data.startDate).toLocaleDateString() : "N/A" %></strong>
          </div>

          <div class="summary-row">
            <span>End Date</span>
            <strong><%= data.endDate ? new Date(data.endDate).toLocaleDateString() : "N/A" %></strong>
          </div>

          <div class="summary-row">
            <span>Total Days</span>
            <strong><%= data.totalDays %></strong>
          </div>

          <div class="summary-total">
            <span>Total</span>
            <strong>$<%= parseFloat(data.totalValue).toFixed(2) %></strong>
          </div>
        </div>

        <form class="payment-form" action="/clients/payment/<%= data.bookingId %>" method="post">
          <h3>Payment Details</h3>

          <div class="payment-form-grid">
            <label for="cardName" class="full-width">Name on Card
              <input type="text" id="cardName" name="cardName" required>
            </label>

            <label for="cardNumber" class="full-width">Card Number
              <input
                type="text"
                id="cardNumber"
                name="cardNumber"
                placeholder="1234 5678 9012 3456"
                maxlength="19"
                required
              >
            </label>

            <label for="expirationDate">Expiration Date
              <input
                type="text"
                id="expirationDate"
                name="expirationDate"
                placeholder="MM/YY"
                maxlength="5"
                required
              >
            </label>

            <label for="cvv">CVV
              <input
                type="text"
                id="cvv"
                name="cvv"
                placeholder="123"
                maxlength="4"
                required
              >
            </label>
          </div>

          <button type="submit" class="btn-success payment-submit-btn">
            Pay and Confirm Booking
          </button>
        </form>
      </div>

      <div class="payment-actions">
        <form action="/clients/payment/<%= data.bookingId %>/cancel" method="post" class="delete-form">
          <button
            type="submit"
            class="btn-danger"
            onclick="return confirm('Are you sure you want to cancel this booking request?')"
          >
            Cancel Booking
          </button>
        </form>

        <a href="/clients/" class="return-link">
          Return to My Bookings
        </a>
      </div>
    </div>
  <% } else { %>
    <p class="notice">Booking not found.</p>
  <% } %>
</section>